<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ingestion automatique des prix toutes les 30 minutes.

  Installation :
    sed "s|__PROJECT_DIR__|$PWD|g" scripts/launchd/fr.carbu-tracker.ingest.plist \
      > ~/Library/LaunchAgents/fr.carbu-tracker.ingest.plist
    launchctl load ~/Library/LaunchAgents/fr.carbu-tracker.ingest.plist

  Désinstallation :
    launchctl unload ~/Library/LaunchAgents/fr.carbu-tracker.ingest.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.carbu-tracker.ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/scripts/launchd/ingest.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/ingest.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/ingest.log</string>
</dict>
</plist>
